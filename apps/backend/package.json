{
  "name": "seatsure-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "env": "node scripts/write-env.mjs",
    "seed": "node --env-file=../frontend/.env.local scripts/seed.mjs",
    "cloud:seed": "node --env-file=.env.production.local scripts/seed.mjs",
    "cloud:courses": "node --env-file=../../.env.production.local scripts/create-demo-courses.mjs",
    "test": "vitest run",
    "test:unsafe": "vitest run --mode unsafe",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
