# Copy to .env.local, or run `npm run db:env` to fill it from the local Supabase stack.
# The only variable the browser bundle reads: the Express API the frontend calls.
VITE_API_URL=http://localhost:3001
# Below: read only by the seed script and the DB/cross-app tests (apps/backend, tests/). Never bundled.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
