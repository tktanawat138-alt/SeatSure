{
  "name": "seatsure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "setup": "supabase start && node scripts/write-env.mjs && node --env-file=.env.local scripts/seed.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:env": "node scripts/write-env.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "db:reset": "supabase db reset && node --env-file=.env.local scripts/seed.mjs",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "test": "vitest run",
    "test:unsafe": "vitest run --mode unsafe",
    "cloud:seed": "node --env-file=.env.production.local scripts/seed.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
